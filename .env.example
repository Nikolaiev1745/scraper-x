# Copia este archivo como .env y completa los valores.
# El .env NO se comparte: contiene tu sesion de X.

# --- Sesion de X (recomendado) -------------------------------------------
# Cookies de tu sesion, en una sola linea. Se sacan del navegador logueado en
# x.com: DevTools (F12) > Application > Cookies > https://x.com
# Copia los valores de auth_token y ct0 y armalos asi:
#   X_COOKIES=auth_token=XXXX; ct0=YYYY
X_COOKIES=

# --- Credenciales (fallback) ---------------------------------------------
# Solo se usan si X_COOKIES esta vacio. Puede pedir 2FA/captcha.
X_LOGIN_USER=
X_LOGIN_PASSWORD=
X_LOGIN_VERIFY=

# --- Preferencias ---------------------------------------------------------
# Usuario a scrapear por defecto (sin @). Se puede cambiar en la web o con
# --target-user. Dejalo vacio para que no quede ningun objetivo fijo.
TARGET_USERNAME=

# Carpeta donde guardar las descargas. Conviene apuntarla a la carpeta del
# caso/investigacion, para no dejar datos dentro de la herramienta.
# Vacio = output/ dentro de esta carpeta.
# Se puede escribir como C:\Casos\expediente o /mnt/c/Casos/expediente: la
# herramienta la adapta sola segun corras en Windows o en WSL.
SCRAPER_OUTPUT_DIR=
